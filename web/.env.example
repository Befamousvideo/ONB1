# Server-only. Never prefix the key with NEXT_PUBLIC_.
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning
XAI_API_BASE=https://api.x.ai/v1

BOOKING_URL=https://calendar.app.google/7KkoctujrZtnzhjU7
PRIVACY_POLICY_URL=https://storentechai.com/privacy

# Postgres when set. Otherwise SQLite (node:sqlite) or a JSON file under the temp dir.
DATABASE_URL=
ONB1_SQLITE_PATH=
ONB1_STORE_PATH=

# Turnstile stays off unless both are set. The site key is public. The secret is not.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
