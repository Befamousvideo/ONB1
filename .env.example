# Shared
APP_ENV=development
LOG_LEVEL=INFO

# Frontend (Next.js) — must match the in-memory FastAPI port
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ONB1

# Backend (FastAPI). DATABASE_URL enables durable staff identity (required for smoke).
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://onb1:onb1_dev_password@127.0.0.1:5432/onb1
SECRET_KEY=replace_with_secure_random_string
