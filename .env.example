# Shared
APP_ENV=development
LOG_LEVEL=INFO

# Public interview (Next.js, deployed on Vercel with Root Directory = web)
# xAI is server-only. Leave the key blank to run on rules + the generic pool.
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning
XAI_API_BASE=https://api.x.ai/v1
BOOKING_URL=https://calendar.app.google/7KkoctujrZtnzhjU7
PRIVACY_POLICY_URL=https://storentechai.com/privacy
# Postgres (Neon or any DATABASE_URL). If unset, the app uses local SQLite, then a JSON file.
DATABASE_URL=
ONB1_SQLITE_PATH=
ONB1_STORE_PATH=
# Cloudflare Turnstile. Both empty = the check is off.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Legacy local API (not the public Vercel interview)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ONB1
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
SECRET_KEY=replace_with_secure_random_string
